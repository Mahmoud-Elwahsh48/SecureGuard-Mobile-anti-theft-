# Auto-detect text files and perform LF normalization
* text=auto

# Explicitly declare text files that must always have LF line endings
*.java text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
gradlew text eol=lf

# Explicitly declare binary files (NEVER convert line endings)
*.jar binary
*.zip binary
*.aar binary
*.apk binary
*.aab binary
*.so binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.keystore binary
