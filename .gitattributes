# Explicitly declare text files that must always have LF line endings
*.java text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
gradlew text eol=lf

# Explicitly declare binary files (NEVER convert line endings or apply LFS filters)
*.jar binary -text -diff -merge
*.zip binary -text -diff -merge
*.aar binary -text -diff -merge
*.apk binary -text -diff -merge
*.aab binary -text -diff -merge
*.so binary -text -diff -merge
*.png binary -text -diff -merge
*.jpg binary -text -diff -merge
*.jpeg binary -text -diff -merge
*.ico binary -text -diff -merge
*.keystore binary -text -diff -merge
